void mj_tick()
{
    if (is_mj_init == 0)
    {
        return;
    }
{%set periods = cc.txPeriods(dev_name)%}
{%for T in periods%}
{%if T > 0%}
    if ((mj_time_us % {{T}}) == 0)
    {
{%for o in outMsg%}
{%if cc.msg[o]['period'] == T%}
        out_{{o}}_msg[0].header.cnt++;
        out_{{o}}_msg[1].header.cnt = out_{{o}}_msg[0].header.cnt;
        mj_udp4tx(tx_{{o}},NULL);

{% endif %}
{% endfor %}
    }
{% endif %}
{% endfor %}
    int m_frac = mj_time_us % 1000000;
    if (m_frac < IN_INT_COUNT)
    {
        mj_mcastJoin(ethInt, group_addr[m_frac]);
    }
    mark_data_as_sent(send_size);
    //char* data = get_buffer_content(&send_size);
    //if (send_size > 0)
    //    mj_send_print_buf((uint8_t*)&print_header, sizeof(msg_header_t), data, send_size);
    mj_time_us+=250;
    mj_txpool();
}

