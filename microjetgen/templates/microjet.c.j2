mj_status_k mj_init()
{
    mj_drvInit();
    ethInt = mj_regEthInterface(devMac, {{devIp}});
    if (ethInt == NULL){return MJ_ETH_INTERFACE_REG_ERR;};

{%for i in in_int%}
{%set ip = cc.interfaces[i]['IP']%}
{%set port = cc.interfaces[i]['port']%}
    if (!mj_regUdp4Cb({{cc.ip4Convert(ip)}}, {{cc.portConvert(port)}}, {{i}}_cb))
    {
        return MJ_RXCB_REG_ERR;
    }
{% endfor %}

    /* OUT */
{%for o in outMsg%}
{%set interface = cc.interfaces[cc.msg[o].transport]%}
{%set port = interface['port']%}
    // {{o}}
    if({{o}}_structCheck() != 0){return MJ_INTEGRETY_CHECK_FAIL;}
    tx_{{o}} = mj_regUdp4Pkt(ethInt, {{cc.ip4Convert(interface['IP'])}}, {{cc.portConvert(port)}}, 0x00,(uint8_t*)&out_{{o}}_msg[0], sizeof(out_{{o}}_msg[0]));
    if (tx_{{o}} == NULL){return MJ_UDP4_PKT_REG_ERR;}
{% if cc.getMsgPrioriry(o) %}
{%endif%}
    out_{{o}}_msg[0].header.src = DEV_SRCID_EN_{{dev_name}};
    out_{{o}}_msg[0].header.cnt = 0;
    out_{{o}}_msg[0].header.id = MSG_ID_EN_{{o}};
    out_{{o}}_msg[0].header.type = MSG_TYPE_EN_{{o}};
    _out.{{o}}.header = &out_{{o}}_msg[0].header;
    _out.{{o}}.data = &out_{{o}}_msg[0].data;
{%if cc.msg[o]['period'] == 0%}
    _out.{{o}}.tx = out_{{o}}_tx_fcn;
    out_{{o}}_msg[0].header.dst = DEV_SRCID_EN_NONE;
{%else%}
    out_{{o}}_msg[0].header.dst = DEV_SRCID_EN_ALL;
    out_{{o}}_msg[1].header = out_{{o}}_msg[0].header;
    _out.{{o}}.mutate = out_{{o}}_mutate_fcn;
    _out.{{o}}.apply = out_{{o}}_apply_fcn;
{%endif%}
{% endfor %}

    /* IN */
{%set dev_src = sorted(cc.inputDev(dev_name))%}
{%for d in dev_src%}
{%set in_dev_m = sorted(cc.inputMsg(dev_name,d))%}
{%for dm in in_dev_m%}
    uint8_t *{{d}}_{{dm}}_ptr = mj_allocUdp4Buff(sizeof({{dm}}_msg_t));
    if ({{d}}_{{dm}}_ptr == NULL){return MJ_UDP4_ALLOC_ERR;};
    _in.{{d}}.{{dm}}.header = &(({{dm}}_msg_t *){{d}}_{{dm}}_ptr)->header;
    _in.{{d}}.{{dm}}.data = &(({{dm}}_msg_t *){{d}}_{{dm}}_ptr)->data;
    _in.{{d}}.{{dm}}.lock = in_{{d}}_{{dm}}_lock_fcn;
    _in.{{d}}.{{dm}}.copy = in_{{d}}_{{dm}}_copy_fcn;
    _in.{{d}}.{{dm}}.regcb = in_{{d}}_{{dm}}_user_cb_reg;
    _in.{{d}}.{{dm}}.status = INMSG_STATUS_OBSOLETE;
{% endfor %}
{% endfor %}

{%if len(prms) > 0%}
    /* PRM */
{%for p in prms%}
    _mj_prm.{{p}} = {{prms[p]["default"]}};
{% endfor %}

{% endif %}
    mj_get_print_buf(&p_print_buf, &buf_size);
    print_header.src = DEV_SRCID_EN_{{dev_name}};
    print_header.cnt = 0;
    print_header.id = MSG_ID_EN_COMPRINT;
    print_header.type = MSG_TYPE_EN_COMPRINT;
    is_mj_init = 1;
    return MJ_OK;
}

void mj_loop()
{
    if (is_mj_init == 0){
        return;
    }
    uint32_t c_time = mj_time_us;
{%for o in inMsg%}
{%set dev_src = sorted(cc.msgSources(o,dev_name))%}
{%if len(dev_src) > 0%}
{%for d in dev_src%}
{% if cc.msg[o]['period']!=0 %}
    if ((_in.{{d}}.{{o}}.status == INMSG_STATUS_ACTUAL) && (((int32_t)(c_time - {{d}}_{{o}}_rx_time)) > {{cc.msg[o]['period']*3}})){
        _in.{{d}}.{{o}}.status = INMSG_STATUS_OBSOLETE;
    }
{% endif %}
    if(in_{{d}}_{{o}}_updated == 1)
    {
{% if o == 'prmReq' %}
        uint32_t prmId = _in.{{d}}.{{o}}.data->id;
        ParametersReqKind rtype = _in.{{d}}.{{o}}.data->type;
        switch (prmId)
        {
{%for p in prms%}
            case MJ_PRM_EN_{{p}}:
                _out.prmAns.data->ans = ParametersStatusKind_OK;
                if (rtype == ParametersReqKind_WRITE)
                {
                    memcpy(&_mj_prm.{{p}},_in.{{d}}.{{o}}.data->val,sizeof(_mj_prm.{{p}}));
                    if (mj_prm_upd_fcn)
                    {
                        mj_prm_upd_fcn(prmId);
                    }
                }
                _out.prmAns.data->id = prmId;
                memcpy(_out.prmAns.data->val,&_mj_prm.{{p}},sizeof(_mj_prm.{{p}}));
                break;
{% endfor %}
            default:
                _out.prmAns.data->ans = ParametersStatusKind_UNKNOWPRM;
                break;
        }
        _out.prmAns.tx(DEV_SRCID_EN_ALL);
{% endif %}
        if (in_{{d}}_{{o}}_user_cb)
        {
            in_{{d}}_{{o}}_user_cb();
        }
        in_{{d}}_{{o}}_updated = 0;
    }
{% endfor %}
{% endif %}
{% endfor %}
};