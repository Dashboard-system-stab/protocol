static uint32_t {{d}}_{{dm}}_rx_time = UINT32_MAX - ({{cc.msg[dm]['period']}}*3+1);
static uint8_t  in_{{d}}_{{dm}}_lock_cnt = 0;
static uint8_t* in_{{d}}_{{dm}}_delayed_ptr = NULL;
static uint8_t  in_{{d}}_{{dm}}_updated = 0;
__attribute__((optimize("O2"))) uint8_t  in_{{d}}_{{dm}}_lock_fcn(bool state)
{
    if (state)
    {
        if (in_{{d}}_{{dm}}_lock_cnt < 255)
        {
            in_{{d}}_{{dm}}_lock_cnt++;
        }
    }else{
        if (in_{{d}}_{{dm}}_lock_cnt > 0)
        {
            if ((in_{{d}}_{{dm}}_lock_cnt == 1) && (in_{{d}}_{{dm}}_delayed_ptr))
            {
                uint8_t* old_buff = (uint8_t*)_in.{{d}}.{{dm}}.header;
                _in.{{d}}.{{dm}}.header = (msg_header_t*)in_{{d}}_{{dm}}_delayed_ptr;
                _in.{{d}}.{{dm}}.data = ({{cc.msg[dm]['type']}}*)(in_{{d}}_{{dm}}_delayed_ptr+sizeof(msg_header_t));
                {{d}}_{{dm}}_rx_time = mj_time_us;
                _in.{{d}}.{{dm}}.status = INMSG_STATUS_ACTUAL;
                in_{{d}}_{{dm}}_updated = 1;
                mj_freeUdp4Buff(old_buff);
                in_{{d}}_{{dm}}_delayed_ptr = NULL;
            }
            in_{{d}}_{{dm}}_lock_cnt--;
        }
    }
    return in_{{d}}_{{dm}}_lock_cnt;
}

__attribute__((optimize("O2"))) void  in_{{d}}_{{dm}}_copy_fcn(void *dst)
{
    in_{{d}}_{{dm}}_lock_fcn(true);
    memcpy(dst, (void *)_in.{{d}}.{{dm}}.header, sizeof({{dm}}_msg_t));
    in_{{d}}_{{dm}}_lock_fcn(false);
}
