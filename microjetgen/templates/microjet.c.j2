static size_t buf_start =0, buf_end=0;
static char* p_print_buf = NULL;
static size_t buf_size = 0;
static size_t send_size = 0;

static char* get_buffer_content(size_t* size) {
    if (p_print_buf == NULL)
    {
        return NULL;
    }
    if (buf_start == buf_end) {
        *size = 0;
        return NULL;  // Buffer is empty
    }

    if (buf_start < buf_end) {
        *size = buf_end - buf_start;
        return p_print_buf + buf_start;
    } else {
        // Return data until the end of the buffer
        *size = buf_size - buf_start;
        return p_print_buf + buf_start;
    }
}

static void mark_data_as_sent(size_t size_sent) {
    if (buf_size == 0)
    {
        return;
    }
    buf_start = (buf_start + size_sent) % buf_size;
    if (buf_start == buf_end) {
        buf_end = 0;
        buf_start = 0;
    }
}

static msg_header_t print_header;

int mj_printf(const char* format, ...) {
    if (p_print_buf)
    {
        va_list args;
        va_start(args, format);
        int available_space, written;
        
        available_space = (buf_start <= buf_end) ?
                        (buf_size - buf_end + buf_start - 1) :
                        (buf_start - buf_end - 1);
        
        if (buf_start < buf_end || (buf_start == buf_end && buf_start == 0)) {
            written = vsnprintf(p_print_buf + buf_end, (unsigned int)available_space, format, args);
        } else {
            written = vsnprintf(p_print_buf + buf_end, buf_size - buf_end, format, args);
        }

        va_end(args);

        if (written < 0 || written >= available_space) {
            return -1;  // Not enough space
        }

        buf_end = (buf_end + written) % buf_size;
        return written;
    }else{
        return -2;  // BUFFER NOT AVALIABLE
    }
}

